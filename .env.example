# Payment gateway secret key (integration key) used for server-side verification of the $1 USD
# early registration fee. Leave empty to run in pre-launch placeholder mode
# (payments stay in "pending" verification until a gateway is configured).
PAYMENT_GATEWAY_SECRET_KEY=4b50424a-5196-4928-b7d5-2366483e27d3

# Payment gateway encryption key, used together with the integration key during
# the $1 USD registration payment verification flow.
PAYMENT_ENCRYPTION_KEY=a6b957c6c647423b8ead6e9abce88c8d

# Payment gateway destination (PesePay) and integration identifiers.
PAYMENT_GATEWAY_BASE_URL=https://api.pesepay.com/api/payments-engine/v1
PAYMENT_GATEWAY_INTEGRATION_ID=

# Supabase project credentials (server-side admin access).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project credentials (browser client access, RLS protected).
NEXT_PUBLIC_SUPABASE_URL=

# Public site URL used for canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=https://uzmarketplace.co.zw
